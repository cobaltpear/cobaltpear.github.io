{
  "format": "pack/1",
  "engine": "comfyui",
  "kind": "Text To Image",
  "id": "civitai-krea2-turbo",
  "label": "Krea 2 Turbo Universal",
  "note": "Paste a Civitai model link in Cobalt Pear's «Your own worker» to set it up for that model. Takes Krea 2 Turbo models (plain Krea 2 ones: civitai-krea2). Start with the creator's settings; most use 8-12 steps, CFG 1, Euler, simple. Write full sentences. No negative prompt.",
  "workflow": {
    "10": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "model.safetensors",
        "weight_dtype": "default"
      }
    },
    "11": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
        "type": "krea2",
        "device": "default"
      }
    },
    "12": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "qwen_image_vae.safetensors"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "11",
          0
        ],
        "text": ""
      }
    },
    "13": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "6",
          0
        ]
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "10",
          0
        ],
        "positive": [
          "6",
          0
        ],
        "negative": [
          "13",
          0
        ],
        "latent_image": [
          "5",
          0
        ],
        "seed": 0,
        "steps": 10,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "3",
          0
        ],
        "vae": [
          "12",
          0
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "8",
          0
        ],
        "filename_prefix": "civitai-krea2"
      }
    }
  },
  "sizes": [
    [
      1024,
